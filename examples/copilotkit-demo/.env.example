# LLM provider (OpenAI or any OpenAI-compatible server). Set at least one.
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENNEST_MODEL=openai/gpt-4o-mini

# PIN asked when unlocking the entrance door (demo only).
# DEMO_DOOR_PIN=1234

# CopilotKit runtime telemetry is on by default; this demo turns it off.
COPILOTKIT_TELEMETRY_DISABLED=true
