    "homedsl",
    "smart-home",
    "dsl",
    "parser",
    "llm"
  ],
  "homepage": "https://github.com/OpenNestHQ/core/tree/main/packages/lang-core#readme",
  "bugs": {
    "url": "https://github.com/OpenNestHQ/core/issues"
  },
  "license": "ISC",
  "author": "Zepoze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenNestHQ/core.git",
    "directory": "packages/lang-core"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
